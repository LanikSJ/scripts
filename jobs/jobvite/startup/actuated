# Source Function Library

# shellcheck disable=SC1091

. /etc/rc.d/init.d/functions

prog=Actuate
START="/home/actuate/AcServer/bin/start_srvr.sh"
STOP="/home/actuate/AcServer/bin/shutdown_srvr.sh -t0 -y"
LOGS=/var/log/actuate/

start() {
        printf "Starting %s:" "$prog"
        if sudo -u actuate $START | sudo tee $LOGS/startup.log >/dev/null; then
            success
        else
            failure
        fi
        printf "\n"
}

stop() {
        printf "Stopping %s: " "$prog"
        if sudo -u actuate "$STOP" | sudo tee $LOGS/shutdown.log >/dev/null; then
            success
        else
            failure
        fi
        printf "\n"
}

case "$1" in
        start)
            start
            ;;

        stop)
            stop
            ;;

        restart)
            stop
            start
            ;;

        *)
            echo "Usage: $0 {start|stop|restart}"
            exit 1

esac
