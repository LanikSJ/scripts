# Source Function Library
. /etc/rc.d/init.d/functions

RETVAL=0
prog=Actuate
START="/home/actuate/AcServer/bin/start_srvr.sh"
STOP="/home/actuate/AcServer/bin/shutdown_srvr.sh -t0 -y"
LOGS=/var/log/actuate/

start() {
        echo -n "Starting $prog:"
        sudo -u actuate $START > $LOGS/startup.log && success || failure
        echo
}

stop() {
        echo -n "Stopping $prog: "
        sudo -u actuate $STOP > $LOGS/shutdown.log && success || failure
        echo
}

case "$1" in
        start)
            start
            ;;

        stop)
            stop
            ;;

        restart)
            stop
            start
            ;;

        *)
            echo $"Usage: $0 {start|stop|restart}"
            exit 1

esac
