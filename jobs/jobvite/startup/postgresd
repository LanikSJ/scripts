# Source Function Library
. /etc/rc.d/init.d/functions

# Set PostgreSQL environment
export LD_LIBRARY_PATH
export pgsql_home
export PATH
PATH=/home/actuate/AcServer/postgresql/bin:$PATH
pgsql_home=/home/actuate/AcServer/postgresql
LD_LIBRARY_PATH=/home/actuate/AcServer/postgresql/lib:$LD_LIBRARY_PATH
encyc_data=/home/actuate/AcServer/data/encyc/postgresql/data
LOGS=/var/log/postgres/
prog=PostgreSQL

# Start/Stop Functions
START="$pgsql_home/bin/postgres -D $encyc_data > $LOGS/startup.log &"
STOP="$pgsql_home/bin/pg_ctl stop -D $encyc_data > $LOGS/shutdown.log &"

RETVAL=0

start() {
        echo -n $"Starting $prog: "
        if [ $UID -ne 0 ]; then
                RETVAL=1
                failure
        else
                daemon --user=actuate $START
                RETVAL=$?
                [ $RETVAL -eq 0 ] && touch /var/lock/subsys/postgres
        fi;
        echo
        return $RETVAL
}

stop() {
        echo -n $"Stopping $prog: "
        if [ $UID -ne 0 ]; then
                RETVAL=1
                failure
        else
                daemon --user=actuate $STOP
                RETVAL=$?
                [ $RETVAL -eq 0 ] && rm -f /var/lock/subsys/postgres
        fi;
        echo
        return $RETVAL
}

case "$1" in
        start)
            start
            ;;

        stop)
            stop
	    sleep 60
            ;;

        restart)
            stop
            start
            ;;

        *)
            echo $"Usage: $0 {start|stop|restart}"
            exit 1

esac
