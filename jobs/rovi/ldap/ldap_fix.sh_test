#!/bin/bash

if grep -q '10.202.0.11' /etc/resolv.conf || grep -q '10.202.0.12' /etc/resolv.conf; then
RHEL5=`rpm -q --queryformat '%{VERSION}' redhat-release`
RHEL6=`rpm -q --queryformat '%{VERSION}' redhat-release-server`
elif [ "$RHEL5" = "5Server" ]; then
	rhncfg-client get /etc/ldap.conf /etc/mail/sendmail.cf
	service nscd restart && service sendmail restart
elif [ "$RHEL6" = "6Server" ]; then
	rhncfg-client get /etc/ldap.conf /etc/nslcd.conf /etc/mail/sendmail.cf
	service nscd restart && service nslcd restart && service sendmail restart
else
	echo "This machine is not in Tulsa" && exit 0
fi
