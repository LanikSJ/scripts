# shellcheck disable=SC1091
. /etc/rc.d/init.d/functions

USER=root
PROG=tomcat
LOCKFILE="/var/lock/${PROG}"
export BASEDIR="/data/${PROG}"
export TOMCAT_HOME="${BASEDIR}"
export CATALINA_PID="/var/run/${PROG}.pid"
# export CATALINA_OPTS="-DHOME=${BASEDIR}/home -Xmx512m -Djava.awt.headless=true"

show_usage() {
    echo "Usage: $0 {start|stop|restart|condrestart|status}"
    exit 1
}

start() {
    echo -n "Starting $PROG: "
    if status -p "$CATALINA_PID" "$PROG" > /dev/null 2>&1 ; then
        failure
        echo
        return 1
    fi

    if su -p -s /bin/sh "$USER" -c "\"${TOMCAT_HOME}/bin/catalina.sh\" start" > /dev/null 2>&1 ; then
        touch "$LOCKFILE"
        success
        echo
        return 0
    else
        failure
        echo
        return 1
    fi
}

stop() {
    echo -n "Shutting down $PROG: "
    if status -p "$CATALINA_PID" "$PROG" > /dev/null 2>&1 ; then
        if su -p -s /bin/sh "$USER" -c "\"${TOMCAT_HOME}/bin/catalina.sh\" stop" > /dev/null 2>&1 ; then
            rm -f "$LOCKFILE"
            success
            echo
            return 0
        else
            failure
            echo
            return 1
        fi
    else
        failure
        echo
        return 1
    fi
}

restart() {
    stop
    start
}

condrestart() {
    if [ -f "$LOCKFILE" ]; then
        restart
    fi
}

status_tomcat() {
    status -p "$CATALINA_PID" "$PROG"
}

case "${1:-}" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart)
        restart
        ;;
    condrestart)
        condrestart
        ;;
    status)
        status_tomcat
        ;;
    *)
        show_usage
        ;;
esac
