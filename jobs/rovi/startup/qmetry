#!/bin/bash
# chkconfig: 2345 86 15
# description: QMetry Service
# Shell script for starting xampp and jasperserver services.

# Source function library for success/failure functions
# shellcheck disable=SC1091
. /etc/init.d/functions

prog="QMetry"
LAMPP_DIR="/opt/lampp"
JASPER_DIR="/opt/jasperserver-3.5.0"

start() {
    echo -n "Starting $prog: "
    
    if (
        cd "$LAMPP_DIR" && ./lampp start &&
        cd "$JASPER_DIR" && ./jasperctl.sh start
    ); then
        success
    else
        failure
    fi
    echo
}

stop() {
    echo -n "Stopping $prog: "

    if (
        cd "$LAMPP_DIR" && ./lampp stop &&
        cd "$JASPER_DIR" && ./jasperctl.sh stop
    ); then
        success
    else
        failure
    fi
    echo
}

restart() {
    echo -n "Restarting $prog: "

    if (
        cd "$LAMPP_DIR" && ./lampp restart &&
        cd "$JASPER_DIR" && ./jasperctl.sh restart
    ); then
        success
    else
        failure
    fi
    echo
}

status() {
    cd "$LAMPP_DIR" && ./lampp status
    # Optionally, check JasperServer status here as well
}

usage() {
    echo "Usage: $0 {start|stop|status|restart|reload}"
    exit 1
}

case "${1:-}" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    status)
        status
        ;;
    restart|reload)
        restart
        ;;
    *)
        usage
        ;;
esac

exit 0
