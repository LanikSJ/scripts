#!/bin/bash
# chkconfig: 2345 80 10
# description: starts and stops jboss

# Exit on error, undefined variable, or error in piped command
set -euo pipefail

# Variables
JBOSS_HOME="${JBOSS_HOME:-/opt/jboss}"
JBOSS_USER="${JBOSS_USER:-jboss}"
JBOSS_HOST="${JBOSS_HOST:-0.0.0.0}"
JAVAPTH="${JAVAPTH:-/usr/lib/jvm/jre-1.6.0/bin}"
JBOSS_CONF="${JBOSS_CONF:-default}"
JBOSSCP="${JBOSSCP:-$JBOSS_HOME/bin/shutdown.jar:$JBOSS_HOME/client/jnet.jar}"
JBOSSSH="${JBOSSSH:-$JBOSS_HOME/bin/run.sh -c $JBOSS_CONF -b $JBOSS_HOST}"
JBOSS_CONSOLE="${JBOSS_CONSOLE:-/dev/null}"

# Bind address option only if JBOSS_HOST is set
if [[ -n "${JBOSS_HOST}" ]]; then
    JBOSS_BIND_ADDR="-b ${JBOSS_HOST}"
else
    JBOSS_BIND_ADDR=""
fi

# Determine if we need to use su
if [[ "${JBOSS_USER}" == "RUNASIS" ]]; then
    SUBIT=()
else
    SUBIT=(su - "${JBOSS_USER}" -c)
fi

# Ensure JBOSS_CONSOLE file exists if not /dev/null
if [[ "${JBOSS_CONSOLE}" != "/dev/null" && ! -e "${JBOSS_CONSOLE}" ]]; then
    touch "${JBOSS_CONSOLE}"
    if [[ -n "${SUBIT[*]}" ]]; then
        chown "${JBOSS_USER}" "${JBOSS_CONSOLE}"
    fi
fi

if [[ ! -d "${JBOSS_HOME}" ]]; then
    echo "JBOSS_HOME does not exist as a valid directory: ${JBOSS_HOME}" >&2
    exit 1
fi

# Add Java binaries to PATH if not present
if [[ ":$PATH:" != *":${JAVAPTH}:"* ]]; then
    export PATH="${PATH}:${JAVAPTH}"
fi

JBOSS_CMD_START="cd \"${JBOSS_HOME}/bin\" && ${JBOSSSH} ${JBOSS_BIND_ADDR}"
JBOSS_CMD_STOP="java -classpath \"${JBOSSCP}\" org.jboss.Shutdown --shutdown"

usage() {
    echo "Usage: $0 {start|stop|restart|help}"
}

case "${1:-}" in
    start)
        cd "${JBOSS_HOME}/bin"
        if [[ -z "${SUBIT[*]}" ]]; then
            eval "${JBOSS_CMD_START}" > "${JBOSS_CONSOLE}" 2>&1 &
        else
            "${SUBIT[@]}" "${JBOSS_CMD_START} > \"${JBOSS_CONSOLE}\" 2>&1 &"
        fi
        ;;
    stop)
        if [[ -z "${SUBIT[*]}" ]]; then
            eval "${JBOSS_CMD_STOP}"
        else
            "${SUBIT[@]}" "${JBOSS_CMD_STOP}"
        fi
        ;;
    restart)
        "$0" stop
        "$0" start
        ;;
    help|--help|-h)
        usage
        ;;
    *)
        usage
        exit 1
        ;;
esac
