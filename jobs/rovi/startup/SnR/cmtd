#!/bin/bash
#
# chkconfig: 2345 99 01
# description: Cluster Manager Tool Service
#
# This file contains a template that you can use to create a script
# that will start, stop and monitor an application used in a cluster 
# service.
#

# Source function library

# shellcheck disable=SC1091
. /etc/init.d/functions

prog="Cluster Manager Tool"
mui_home="/opt/mui/cluster_manager"
LOGS="$mui_home/logs"
START_CMD="$mui_home/bin/start.sh"
STOP_CMD="$mui_home/bin/stop.sh"
START_LOG="$LOGS/startup.log"
STOP_LOG="$LOGS/shutdown.log"

# Ensure logs directory exists
mkdir -p "$LOGS"

RETVAL=0

start() {
    echo -n $"Starting $prog: "
    if [[ $EUID -ne 0 ]]; then
        RETVAL=1
        failure
    else
        # Use daemon to run start script, redirect output to log
        daemon bash -c "\"$START_CMD\" > \"$START_LOG\" 2>&1"
        RETVAL=$?
        [ $RETVAL -eq 0 ] && touch /var/lock/subsys/cmtd
    fi
    echo
    return $RETVAL
}

stop() {
    echo -n $"Stopping $prog: "
    if [[ $EUID -ne 0 ]]; then
        RETVAL=1
        failure
    else
        # Use daemon to run stop script, redirect output to log
        daemon bash -c "\"$STOP_CMD\" > \"$STOP_LOG\" 2>&1"
        RETVAL=$?
        [ $RETVAL -eq 0 ] && rm -f /var/lock/subsys/cmtd
    fi
    echo
    return $RETVAL
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart)
        stop
        start
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}" >&2
        exit 1
        ;;
esac
