#!/bin/bash
#
# chkconfig: 2345 99 01
# description: SOLR Service
#
# This file contains a template that you can use to create a script
# that will start, stop and monitor an application used in a cluster 
# service.
#

# shellcheck disable=SC1091
. /etc/init.d/functions

prog="SOLR Service"

# Determine mui_home directory
if [ -d /home/recservice ]; then
    mui_home="/home/recservice"
else
    mui_home="/opt/recservice"
fi

LOGS="$mui_home/logs"
START_CMD="cd \"$mui_home\" && ./mui_control/start.sh > \"$LOGS/startup.log\" 2>&1"
STOP_CMD="cd \"$mui_home\" && ./mui_control/stop.sh > \"$LOGS/shutdown.log\" 2>&1"

RETVAL=0

# Ensure logs directory exists and owned by recservice
mkdir -p "$LOGS"
chown -R recservice:recservice "$LOGS"

start() {
    echo -n $"Starting $prog: "
    if [ "$EUID" -ne 0 ]; then
        RETVAL=1
        failure
    else
        daemon --user=recservice bash -c "$START_CMD"
        RETVAL=$?
        [ "$RETVAL" -eq 0 ] && touch /var/lock/subsys/recsd
    fi
    echo
    return $RETVAL
}

stop() {
    echo -n $"Stopping $prog: "
    if [ "$EUID" -ne 0 ]; then
        RETVAL=1
        failure
    else
        daemon --user=recservice bash -c "$STOP_CMD"
        RETVAL=$?
        [ "$RETVAL" -eq 0 ] && rm -f /var/lock/subsys/recsd
    fi
    echo
    return $RETVAL
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart)
        stop
        start
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}" >&2
        exit 1
        ;;
esac
