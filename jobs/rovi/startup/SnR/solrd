# source function library
. /etc/init.d/functions

if [ -d /home/recservice ]; then
	mui_home="/home/recservice"
else
	mui_home="/opt/recservice"
fi

LOGS="$mui_home/logs"
START="cd $mui_home; mui_control/start.sh > $LOGS/startup.log"
STOP="cd $mui_home; mui_control/stop.sh > $LOGS/shutdown.log"
prog="SOLR Service"

RETVAL=0

mkdir -p $LOGS
chown -R recservice:recservice $LOGS

start() {
        echo -n $"Starting $prog: "
        if [ $UID -ne 0 ]; then
                RETVAL=1
                failure
        else
                daemon --user=recservice $START
                RETVAL=$?
                [ $RETVAL -eq 0 ] && touch /var/lock/subsys/recsd
        fi;
        echo
        return $RETVAL
}

stop() {
        echo -n $"Stopping $prog: "
        if [ $UID -ne 0 ]; then
                RETVAL=1
                failure
        else
                daemon --user=recservice $STOP
                RETVAL=$?
                [ $RETVAL -eq 0 ] && rm -f /var/lock/subsys/recsd
        fi;
        echo
        return $RETVAL
}

case "$1" in
        start)
            start
            ;;

        stop)
            stop
            ;;

        restart)
            stop
            start
            ;;

        *)
            echo $"Usage: $0 {start|stop|restart}"
            exit 1

esac
