#!/bin/bash
#
# Directory Server Startup Script
#
# chkconfig: 2345 99 04
# description: start jira
#

# Source function library for success/failure functions
# shellcheck disable=SC1091
. /etc/rc.d/init.d/functions

prog="jira"

JAVA_HOME=/usr/java/default
# JAVA_OPTS=-server -Xms512m -Xmx1024m
export JAVA_HOME
export JAVA_OPTS

# Use absolute path variables for easier maintenance
JIRA_HOME="/jira/jira"
STARTUP_SCRIPT="${JIRA_HOME}/bin/startup.sh"
SHUTDOWN_SCRIPT="${JIRA_HOME}/bin/shutdown.sh"
STARTUP_LOG="${JIRA_HOME}/logs/startup.log"
SHUTDOWN_LOG="${JIRA_HOME}/logs/shutdown.log"

start() {
    echo -n "Starting $prog: "
    if su - jira -c "${STARTUP_SCRIPT}" > "${STARTUP_LOG}" 2>&1; then
        success
    else
        failure
    fi
    echo
}

stop() {
    echo -n "Stopping $prog: "
    if su - jira -c "${SHUTDOWN_SCRIPT}" > "${SHUTDOWN_LOG}" 2>&1; then
        success
    else
        failure
    fi
    echo
}

usage() {
    echo "Usage: $0 {start|stop|restart}"
    exit 1
}

case "${1:-}" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart)
        stop
        start
        ;;
    *)
        usage
        ;;
esac
