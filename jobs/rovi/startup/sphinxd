# source function library
. /etc/init.d/functions

START="-c /var/lib/sphinx/etc/sphinx.conf > /dev/null 2>&1"
STOP="-c /var/lib/sphinx/etc/sphinx.conf --stop > /dev/null 2>&1"

RETVAL=0
prog="Sphinx Search"

start() {
        echo -n $"Starting $prog: "
        if [ $UID -ne 0 ]; then
                RETVAL=1
                failure
        else
                daemon --user=sphinx /var/lib/sphinx/bin/searchd $START
                RETVAL=$?
                [ $RETVAL -eq 0 ] && touch /var/lock/subsys/searchd
        fi;
        echo
        return $RETVAL
}

stop() {
        echo -n $"Stopping $prog: "
        if [ $UID -ne 0 ]; then
                RETVAL=1
                failure
        else
                #killproc /var/lib/sphinx/bin/searchd
                daemon --user=sphinx /var/lib/sphinx/bin/searchd $STOP
                RETVAL=$?
                [ $RETVAL -eq 0 ] && rm -f /var/lock/subsys/searchd
        fi;
        echo
        return $RETVAL
}

status() {
        su - sphinx -c '/var/lib/sphinx/bin/searchd -c /var/lib/sphinx/etc/sphinx.conf --status'
        echo
    RETVAL=$?
    return $RETVAL
}

case "$1" in
        start)
            start
            ;;

        stop)
            stop
            ;;

        status)
            status
            ;;

        restart)
            stop
            start
            ;;

        *)
            echo $"Usage: $0 {start|stop|status|restart}"
            exit 1

esac
