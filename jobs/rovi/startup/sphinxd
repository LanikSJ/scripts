# Source function library
# shellcheck disable=SC1091
. /etc/init.d/functions

prog="Sphinx Search"
LOCKFILE="/var/lock/subsys/searchd"
SPHINX_USER="sphinx"
SPHINX_BIN="/var/lib/sphinx/bin/searchd"
SPHINX_CONF="/var/lib/sphinx/etc/sphinx.conf"
START_OPTS="-c ${SPHINX_CONF}"
STOP_OPTS="-c ${SPHINX_CONF} --stop"

ret=0

start() {
    echo -n "Starting $prog: "
    if [[ $EUID -ne 0 ]]; then
        echo "Must be run as root" >&2
        failure
        ret=1
    else
        daemon --user="$SPHINX_USER" "$SPHINX_BIN" "$START_OPTS" > /dev/null 2>&1
        ret=$?
        if [[ $ret -eq 0 ]]; then
            touch "$LOCKFILE"
            success
        else
            failure
        fi
    fi
    echo
    return $ret
}

stop() {
    echo -n "Stopping $prog: "
    if [[ $EUID -ne 0 ]]; then
        echo "Must be run as root" >&2
        failure
        ret=1
    else
        # killproc is commented out in your original, so we keep it commented here.
        # killproc "$SPHINX_BIN"
        daemon --user="$SPHINX_USER" "$SPHINX_BIN" "$STOP_OPTS" > /dev/null 2>&1
        ret=$?
        if [[ $ret -eq 0 ]]; then
            rm -f "$LOCKFILE"
            success
        else
            failure
        fi
    fi
    echo
    return $ret
}

status() {
    # Run as sphinx user to query status
    su - "$SPHINX_USER" -c "\"$SPHINX_BIN\" -c \"$SPHINX_CONF\" --status"
    ret=$?
    echo
    return $ret
}

usage() {
    echo "Usage: $0 {start|stop|status|restart}"
    exit 1
}

case "${1:-}" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    status)
        status
        ;;
    restart)
        stop
        start
        ;;
    *)
        usage
        ;;
esac
